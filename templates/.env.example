# === REQUIRED ===
# Which loop to run: "new-code" or "bug-fix"
LOOP_TYPE=new-code

# === NEW-CODE LOOP ===
FEATURE_SPEC="Implement user authentication with JWT and refresh tokens"

# === BUG-FIX LOOP ===
BUG_DESCRIPTION="Ledger balance off by 1 cent on EUR to USD conversions"
BUG_ISSUE_URL="https://github.com/user/repo/issues/42"

# === OPTIONAL ===
# Override default attempt limits (new-code=3, bug-fix=2)
LOOP_MAX_ATTEMPTS=3

# Path to the work-log file (defaults to ./work-log.json)
LOOP_WORK_LOG=work-log.json
